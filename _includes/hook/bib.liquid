{%- comment -%}
  Reports (institution-based entries): show institution, series and number
  as the venue line, since the default layout only handles journals,
  proceedings and theses.
{%- endcomment -%}
{%- if entry.institution -%}
  {%- capture entrytype -%}
    {{- entry.institution -}}
    {%- if entry.series -%}, {{ entry.series }}{%- endif -%}
    {%- if entry.number %} {{ entry.number }}{%- endif -%}
  {%- endcapture -%}
{%- endif -%}
